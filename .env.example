# Copy to .env before running docker compose. Development values only.
DB_USER=lab
DB_PASSWORD=lab_dev_password
DB_NAME=owasp_lab

JWT_SECRET=dev-only-secret-change-me-please-0123456789
JWT_EXPIRES_IN=1h

# Origin allowed by the API CORS policy
WEB_ORIGIN=http://localhost:3000

# Used by the browser, so it must be reachable from the host machine
NEXT_PUBLIC_API_URL=http://localhost:3001
